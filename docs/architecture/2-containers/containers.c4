// C4 Level 2: Containers
model {
  extend macrotouch {
    electron = container 'Desktop App' {
      description 'Shows the editor window and optional tray icon; starts the master server if it is not running'
      technology 'Electron'
    }

    master = container 'Master Server' {
      description 'Holds all user data, keeps every client in sync, and sends actions to the right action server'
      technology 'Node.js'
    }

    action = container 'Action Server' {
      description 'Runs actions on this computer and reports their live state'
      technology 'Node.js'
    }

    editor = webapp 'Desktop Editor' {
      description 'Where the user builds screens and macros'
      technology 'Vue SPA'
    }

    controller = webapp 'Mobile Controller' {
      description 'Shows macro screens on a phone or tablet'
      technology 'Vue SPA'
    }

    plugins = datastore 'Plugin Packages' {
      description 'Every plugin installed from the editor, kept by the master and copied to each action server'
      technology '~/.macroTouch/plugins'
    }

    pluginCopies = datastore 'Plugin Copies' {
      description 'The plugins this action server runs: built-in ones plus its copy of each installed one'
      technology 'plugins/core-*, action server data folder'
    }

    pluginSecrets = datastore 'Plugin Secrets' {
      description 'Tokens and passwords that plugins use on this computer'
      technology 'file, mode 0600'
    }

    desktopSettings = datastore 'Desktop Settings' {
      description 'Start on login, tray icon, and quit when closed, for this computer'
      technology 'JSON file'
    }

    state = datastore 'State File' {
      description 'Saved screens, macros, and settings'
      technology 'JSON file'
    }

    devicesFile = datastore 'Device Records' {
      description 'Every paired device with its role, name, settings, and a hash of its secret; kept out of the state file, which is sent to every client'
      technology 'JSON file'
    }

    actionSecret = datastore 'Action Server Secret' {
      description 'The secret that proves this action server to the master'
      technology 'file, mode 0600'
    }

    electron -> master 'starts if not running, reads its setup code' {
      technology 'detached process'
    }
    electron -[message]-> master 'quit' {
      technology 'WebSocket'
    }
    electron -> editor 'shows' {
      technology 'BrowserWindow'
    }
    electron -> controller 'shows the MacroPad window on this computer' {
      technology 'BrowserWindow'
    }
    electron -[call]-> desktopSettings 'reads/writes' {
      technology 'fs'
    }
  }

  user -> macrotouch.editor 'edits macros'
  user -> macrotouch.controller 'taps macros'
  os -> macrotouch.master 'starts at login (optional, no tray)' {
    technology 'login item'
  }
  os -> macrotouch.electron 'starts at login (optional, tray icon)' {
    technology 'login item'
  }
}

views "2. Containers" {
  view containers of macrotouch {
    title 'Containers'
    include *, user, os
    // Summary titles for edges that roll up from Level 3 as [...]
    include macrotouch.editor -> macrotouch.master with {
      title 'pairs, loads pages and plugin faces, syncs edits, installs plugins'
      technology 'HTTP, WebSocket'
    }
    include macrotouch.controller -> macrotouch.master with {
      title 'pairs, loads pages and plugin faces, sends taps, gets live state'
      technology 'HTTP, WebSocket'
    }
    include macrotouch.action -> macrotouch.master with {
      title 'enrolls, gets plugins, runs actions, reports live state'
      technology 'WebSocket'
    }
    include macrotouch.action -> os with {
      title 'checks for apps and tools, runs OS commands'
    }
    include macrotouch.electron -> macrotouch.master with {
      title 'starts if not running, claims a new install, sends quit'
      technology 'detached process, WebSocket'
    }
  }
}
