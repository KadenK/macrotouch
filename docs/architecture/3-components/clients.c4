// C4 Level 3: Clients (code inside each web app)
model {
  extend macrotouch.editor {
    ws = service 'MasterConnection' {
      description 'Connects to the master server and passes messages both ways'
      technology 'composables/useWebSocket.ts'
    }

    store = service 'EditorStore' {
      description 'Local copy of user data, the action list, and the device list; sends edits to the master'
      technology 'Pinia'
    }

    start = ui 'StartPage' {
      description 'Page for a device with no credential: claims a new install with the setup code, or asks to pair'
      technology 'pages/index.vue'
    }

    screens = ui 'ScreenEditor' {
      description 'Page for laying out screens and macros'
      technology 'pages/home.vue'
    }

    macroEditor = ui 'MacroEditor' {
      description 'Form for choosing a macro\'s action, settings, and look'
      technology 'components/macro/*'
    }

    settings = ui 'SettingsPage' {
      description 'Page for app settings, including start on login, tray icon, and quit when closed'
      technology 'pages/settings.vue'
    }

    pair = ui 'PairPage' {
      description 'Page where an editor turns pairing mode on, approves requests, and sees the number to match'
      technology 'pages/editor/pair.vue'
    }

    devices = ui 'DevicesPage' {
      description 'Page that lists paired devices to rename, set a default screen, or revoke, and mints enrollment tokens for action servers'
      technology 'pages/editor/devices.vue'
    }

    ws -[event]-> store 'message'
    ws -[event]-> start 'claimed, pair-choices, pair-result, error'
    ws -[event]-> pair 'pair-prompt, pair-challenge, pairing-mode'
    store -[call]-> ws 'send(command)'
    start -[call]-> ws 'send(claim, pair-request, pair-answer)'
    pair -[call]-> ws 'send(pair-decision, resume-pairing)'
    devices -[call]-> store 'read devices'
    devices -[call]-> ws 'send(update-device, revoke-device, create-enrollment-token)'
    screens -[call]-> store 'read, moveMacro()'
    macroEditor -[call]-> store 'read, upsertMacro()'
    settings -[call]-> store 'read, updateSettings()'
  }

  extend macrotouch.controller {
    ws = service 'MasterConnection' {
      description 'Connects to the master server and passes messages both ways'
      technology 'composables/useWebSocket.ts'
    }

    store = service 'ControllerStore' {
      description 'Local copy of screens, macros, this device\'s settings, and live action state; sends taps to the master'
      technology 'Pinia'
    }

    start = ui 'StartPage' {
      description 'Page for a device with no credential: asks to pair, shows the numbers to tap, and finishes pairing'
      technology 'pages/index.vue'
    }

    grid = ui 'ScreenGrid' {
      description 'Shows the current screen; swipe to change screens'
      technology 'pages/remote.vue'
    }

    cell = ui 'MacroCell' {
      description 'One macro on screen: a button, slider, or readout'
      technology 'components/macro/MacroCell.vue'
    }

    ws -[event]-> store 'message'
    ws -[event]-> start 'pair-choices, pair-result, revoked, error'
    store -[call]-> ws 'send(trigger, view-screen)'
    start -[call]-> ws 'send(pair-request, pair-answer)'
    grid -[call]-> store 'read screens, setScreen()'
    grid -[call]-> cell 'renders'
    cell -[call]-> store 'read state, trigger()'
  }

  macrotouch.editor.ws -[message]<-> macrotouch.master.gateway 'hello, snapshot, commands, state-patch, claim, pair-decision, resume-pairing, devices, update-device, revoke-device, create-enrollment-token' {
    technology 'WebSocket'
  }
  macrotouch.controller.ws -[message]<-> macrotouch.master.gateway 'hello, snapshot, pair-request, pair-answer, view-screen, macro-trigger, state-patch, action-state' {
    technology 'WebSocket'
  }
  macrotouch.editor.settings -[message]-> macrotouch.electron 'desktop settings' {
    technology 'IPC (preload)'
  }
  macrotouch.editor.pair -[message]-> macrotouch.master.http 'GET /api/ip' {
    technology 'HTTP'
  }
}

views "3. Components" {
  view editor of macrotouch.editor {
    title 'Desktop Editor'
    description 'Boxes are code inside the editor web app. Arrows: solid = call, dashed = event, dotted = network.'
    include *
    include -> macrotouch.editor ->
  }

  view controller of macrotouch.controller {
    title 'Mobile Controller'
    description 'Boxes are code inside the controller web app. Arrows: solid = call, dashed = event, dotted = network.'
    include *
    include -> macrotouch.controller ->
  }
}
