// C4 Level 3: Master Server (code inside the master process)
model {
  extend macrotouch.master {
    http = service 'WebServer' {
      description 'Serves web app pages to paired devices, sets the credential cookie when pairing completes, and gives out this computer\'s IP address'
      technology 'master-server/http.ts'
    }

    gateway = service 'SocketServer' {
      description 'Accepts connections, checks who each one is, and passes messages along'
      technology 'master-server/gateway.ts'
    }

    store = service 'StateStore' {
      description 'Holds screens, macros, and settings in memory and applies changes'
      technology 'master-server/state-store.ts'
    }

    stateFile = module 'StateFile' {
      description 'Reads and writes the state file'
      technology 'master-server/state-file.ts'
    }

    devices = service 'DeviceRegistry' {
      description 'Holds every paired device and its settings, creates and revokes them, and checks their secrets'
      technology 'master-server/device-registry.ts'
    }

    deviceFile = module 'DeviceFile' {
      description 'Reads and writes the device file'
      technology 'master-server/device-file.ts'
    }

    pairing = service 'PairingService' {
      description 'Runs the first-install claim, pairing mode, the number match, and action server enrollment'
      technology 'master-server/pairing-service.ts'
    }

    actionServers = service 'ActionServerRegistry' {
      description 'Tracks connected action servers, their actions, and the latest action state'
      technology 'master-server/action-server-registry.ts'
    }

    watch = service 'WatchTracker' {
      description 'Works out which live actions are on screen and tells each action server'
      technology 'master-server/watch-tracker.ts'
    }

    launcher = service 'ActionServerLauncher' {
      description 'Starts the local action server, restarts it if it stops, and stops it on quit'
      technology 'master-server/action-server-launcher.ts'
    }

    router = service 'ActionRouter' {
      description 'Finds which action server should run a macro and sends it there'
      technology 'master-server/action-router.ts'
    }

    http -[call]-> devices 'authenticate(cookie)'
    http -[call]-> pairing 'complete(ticket)'
    gateway -[call]-> devices 'authenticate(cookie or secret), update(), revoke()'
    gateway -[call]-> pairing 'claim, request, decide, answer, enroll, resume'
    pairing -[event]-> gateway 'prompt, challenge, choices, mode'
    pairing -[call]-> devices 'create(role, label)'
    devices -[event]-> gateway 'change, revoked'
    devices -[call]-> deviceFile 'load(), save()'
    launcher -[call]-> pairing 'mintEnrollmentToken()'
    gateway -[call]-> store 'apply(command)'
    store -[event]-> gateway 'change'
    store -[call]-> stateFile 'load(), save()'
    gateway -[call]-> actionServers 'register(), setState()'
    actionServers -[event]-> gateway 'change'
    gateway -[call]-> router 'trigger()'
    gateway -[call]-> watch 'setViewedScreen(), removeClient()'
    store -[event]-> watch 'change'
    watch -[call]-> store 'getScreen(), getMacro()'
    watch -[call]-> gateway 'send(deviceId, watch-actions)'
    router -[call]-> store 'getMacro()'
    router -[call]-> actionServers 'get(deviceId)'
    router -[call]-> gateway 'request(deviceId, run-action)'
  }

  macrotouch.editor -[message]-> macrotouch.master.http 'GET pages, POST /api/pair/complete' {
    technology 'HTTP'
  }
  macrotouch.controller -[message]-> macrotouch.master.http 'GET pages, POST /api/pair/complete' {
    technology 'HTTP'
  }
  macrotouch.master.launcher -> macrotouch.action 'starts with an enrollment token, restarts, stops' {
    technology 'child process'
  }
  macrotouch.master.stateFile -[call]-> macrotouch.state 'read/write' {
    technology 'fs'
  }
  macrotouch.master.deviceFile -[call]-> macrotouch.devicesFile 'read/write' {
    technology 'fs'
  }
}

views "3. Components" {
  view master of macrotouch.master {
    title 'Master Server'
    description 'Boxes are code inside the master process. Arrows: solid = call, dashed = event, dotted = network.'
    include *
    include -> macrotouch.master ->
  }
}
