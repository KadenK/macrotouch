// C4 Level 3: Action Server (code inside the action server process)
model {
  extend macrotouch.action {
    masterLink = service 'MasterConnection' {
      description 'Connects to the master server and passes messages both ways'
      technology 'action-server/master-link.ts'
    }

    pluginHost = service 'PluginHost' {
      description 'Keeps this computer\'s plugin copies matching the master, loads them, and starts and stops them'
      technology 'action-server/plugin-host.ts'
    }

    checks = module 'CompatibilityChecks' {
      description 'Checks whether this computer can run a plugin or action, now and in general, using the checks the plugin declares'
      technology 'action-server/checks.ts'
    }

    pluginSettings = service 'PluginSettings' {
      description 'Keeps each plugin\'s settings and secrets for this computer'
      technology 'action-server/plugin-settings.ts'
    }

    catalog = service 'ActionCatalog' {
      description 'Lists the actions of every loaded plugin, and whether each can run on this computer'
      technology 'action-server/catalog.ts'
    }

    runner = service 'ActionRunner' {
      description 'Runs an action using its version for this OS and returns the result'
      technology 'action-server/runner.ts'
    }

    monitor = service 'StateMonitor' {
      description 'Reads or subscribes to the live state of on-screen actions and reports changes'
      technology 'action-server/monitor.ts'
    }

    credential = service 'Credential' {
      description 'Keeps this action server\'s secret, or trades a one-time enrollment token for one'
      technology 'action-server/credential.ts'
    }

    actions = module 'Actions' {
      description 'The loaded action code, from built-in and installed plugins alike'
      technology 'plugin server.mjs'
    }

    masterLink -[call]-> credential 'secret(), enroll(token)'
    masterLink -[call]-> catalog 'toCatalog()'
    masterLink -[call]-> runner 'run(id, params), listOptions()'
    masterLink -[call]-> pluginHost 'sync(plugin-sync)'
    masterLink -[call]-> pluginSettings 'setSecrets()'
    pluginHost -[call]-> checks 'requires(plugin)'
    pluginHost -[call]-> pluginSettings 'get(pluginId)'
    pluginHost -[call]-> actions 'activate(ctx), dispose()'
    pluginHost -[event]-> masterLink 'catalog changed'
    catalog -[call]-> pluginHost 'loaded()'
    catalog -[call]-> checks 'availability(action)'
    runner -[call]-> checks 'ready(action)'
    runner -[call]-> catalog 'get(id)'
    runner -[call]-> actions 'execute(params)'
    masterLink -[call]-> monitor 'setWatched(list)'
    monitor -[call]-> catalog 'get(id)'
    monitor -[call]-> actions 'get(), subscribe()'
    monitor -[event]-> masterLink 'change'
  }

  macrotouch.action.masterLink -[message]<-> macrotouch.master.gateway 'hello (with secret and catalog), enroll, enrolled, plugin-sync, plugin-secrets, run-action, list-options, test-plugin, action-result, watch-actions, action-state' {
    technology 'WebSocket'
  }
  macrotouch.action.credential -[call]-> macrotouch.actionSecret 'read/write' {
    technology 'fs'
  }
  macrotouch.action.pluginHost -[message]-> macrotouch.master.http 'GET plugin package' {
    technology 'HTTP'
  }
  macrotouch.action.pluginHost -[call]-> macrotouch.pluginCopies 'write, import()' {
    technology 'fs'
  }
  macrotouch.action.pluginSettings -[call]-> macrotouch.pluginSecrets 'read/write' {
    technology 'fs'
  }
  macrotouch.action.checks -[call]-> os 'look for files, commands, processes'
  macrotouch.action.actions -[call]-> os 'OS commands and APIs'
  macrotouch.action.actions -[message]-> apps 'app and service APIs'
}

views "3. Components" {
  view action of macrotouch.action {
    title 'Action Server'
    description 'Boxes are code inside the action server process. Arrows: solid = call, dashed = event, dotted = network.'
    include *
    include -> macrotouch.action ->
  }
}
