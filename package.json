{
  "name": "macrotouch",
  "type": "module",
  "private": true,
  "version": "0.0.2",
  "description": "Desktop-first macro pad for touch devices",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/KadenK/macrotouch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KadenK/macrotouch.git"
  },
  "bugs": {
    "url": "https://github.com/KadenK/macrotouch/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n ui,master \"cross-env MASTER_HTTP_PORT=4323 nuxt dev\" \"cross-env MACROTOUCH_HTTP_PORT=4323 MACROTOUCH_ACTION_ENTRY=action-server/index.ts tsx watch master-server/index.ts\"",
    "dev:electron": "concurrently -k -n ui,master,electron \"cross-env MASTER_HTTP_PORT=4323 nuxt dev\" \"cross-env MACROTOUCH_HTTP_PORT=4323 MACROTOUCH_ACTION_ENTRY=action-server/index.ts tsx watch master-server/index.ts\" \"wait-on http://localhost:4321 && cross-env NODE_ENV=development MACROTOUCH_HTTP_PORT=4323 electron .\"",
    "build": "npm run generate && npm run build:master && npm run build:action",
    "generate": "nuxt generate",
    "preview": "npm run start:master",
    "postinstall": "nuxt prepare",
    "electron:preview": "npm run build && cross-env NODE_ENV=production electron .",
    "dist": "npm run build && cross-env NODE_ENV=production electron-builder",
    "dist:wine": "npm run build && cross-env NODE_ENV=production electron-builder --win nsis --x64",
    "docs": "likec4 start docs/architecture",
    "test:protocol": "node scripts/protocol-check.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "build:master": "esbuild master-server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-master/index.mjs --external:ws",
    "build:action": "esbuild action-server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-action/index.mjs --external:ws --external:node-notifier",
    "start:master": "node dist-master/index.mjs",
    "start:action": "node dist-action/index.mjs",
    "typecheck:protocol": "tsc -p tsconfig.protocol.json"
  },
  "dependencies": {
    "node-notifier": "^10.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@iconify-json/codicon": "^1.2.51",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/game-icons": "^1.2.3",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.66",
    "@iconify-json/simple-icons": "^1.2.77",
    "@iconify/utils": "^3.1.0",
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/icon": "^2.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@types/node-notifier": "^8.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "likec4": "^1.59.4",
    "nuxt": "^4.3.1",
    "postcss-nested": "^7.0.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "wait-on": "^9.0.4"
  },
  "build": {
    "asar": false,
    "appId": "com.macrotouch.app",
    "productName": "MacroTouch",
    "icon": "images/macrotouch-logo-512.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "images/**/*",
      "dist-master/**/*",
      "dist-action/**/*",
      ".output/public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "author": {
    "name": "Kaden Keep",
    "email": "me@kadenkeep.com"
  }
}
