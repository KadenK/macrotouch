{
  "name": "@macrotouch/plugin-core-system",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "macrotouch": {
    "id": "core-system",
    "label": "System",
    "icon": "ic:baseline-settings",
    "apiVersion": 1,
    "checks": {
      "linux-clipboard": {
        "anyOf": [
          {
            "type": "command",
            "name": {
              "linux": "wl-copy"
            }
          },
          {
            "type": "command",
            "name": {
              "linux": "xclip"
            }
          }
        ],
        "message": "Neither wl-copy nor xclip is installed",
        "hint": "Install wl-clipboard (Wayland) or xclip (X11)"
      }
    },
    "actions": {
      "launchApp": {},
      "shellCommand": {},
      "sendNotification": {},
      "openUrl": {},
      "openPath": {},
      "setClipboard": {
        "requires": [
          "linux-clipboard"
        ]
      }
    }
  }
}
